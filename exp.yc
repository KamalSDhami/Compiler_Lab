%{
#include<stdio.h>
#include<stdlib.h>
void yyerror(const char *s);
int yylex();
%}

%token NUM PLUS MINUS MUL DIV LP RP

%left PLUS MINUS
%left MUL DIV
%left LP RP

%%
s:
      expr '\n' { printf("Result = %d\n", $1); }
    ;
expr:
      expr PLUS expr   { $$ = $1 + $3; }
    | expr MINUS expr  { $$ = $1 - $3; }
    | expr MUL expr    { $$ = $1 * $3; }
    | expr DIV expr    { 
                          if($3 == 0) {
                              printf("Division by zero error\n");
                              exit(1);
                          }
                          $$ = $1 / $3; 
                        }
    | LP expr RP     { $$ = $2; }
    | NUM              { $$ = $1; }
    ;
%%

void yyerror(const char *s) {
    printf("Error: %s\n", s);
}

int main() {
    printf("Enter Arithmetic Expression:\n");
    yyparse();
    return 0;
}